# Groq API
GROQ_API_KEY=your_groq_api_key_here

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_influxdb_org_here
INFLUXDB_BUCKET=your_influxdb_bucket_here
# Used by docker/docker-compose.yml when the InfluxDB container is first created
# (start it with: docker compose --env-file .env -f docker/docker-compose.yml up -d)
INFLUXDB_ADMIN_PASSWORD=choose_a_strong_password
# Red Team agent (authorized testing of this application's own model)
RED_TEAM_ENABLED=true
RED_TEAM_MAX_TESTS=10
RED_TEAM_MAX_TURNS=5
# Every attack runs the full defence (3 security agents + model), so allow time.
RED_TEAM_TIMEOUT=300
RED_TEAM_QUICK_TESTS=3
RED_TEAM_STANDARD_TESTS=7
RED_TEAM_DEEP_TESTS=10
RED_TEAM_STOP_ON_CRITICAL=false
RED_TEAM_LLM_JUDGE=true

# Security alerts
SECURITY_ALERT_THRESHOLD=70
CRITICAL_ALERT_THRESHOLD=85
SECURITY_ALERT_COOLDOWN=5
DESKTOP_NOTIFICATIONS=true
SECURITY_LOG_LEVEL=INFO

# Optional: HTTP bridge to a host-side listener (needed only if the backend
# runs inside Docker - see scripts/host_alert_listener.py)
# SECURITY_WEBHOOK_URL=http://host.docker.internal:8765/alert

# Operator access: required to see security data and run Red Team.
# Choose a long random value; never share it with chat users.
OPERATOR_TOKEN=change_me_to_a_long_random_value

# Session ids are signed with this secret; clients cannot choose their own.
# Set a long random value (if empty, a new one is generated at every start and
# existing browser sessions simply get new ids).
SESSION_SECRET=change_me_to_another_long_random_value

# Security agents (CrewAI): every message is judged by the Sentry, Analyst and
# Orchestrator agents. They are the only source of the routing decision.
# Agent models on Groq, in order of preference. Groq limits tokens per minute and per
# day PER MODEL, so when the first model is rate limited (HTTP 429) the agents switch
# to the next one until the first model's retry-after time has passed; with every model
# limited, messages are held with a "try again" reply. gpt-oss-20b is the validated
# model (see validation/evaluate.py --mode agents); re-run that evaluation before
# relying on a fallback: the operator view shows which model decided each message.
CREW_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# 1 = when the agents cannot answer (rate limit), judge on the sensors alone instead of
# holding the message. The operator view shows engine "sensor-fallback". Recommended for
# demos on a free Groq key; leave unset in production (agents only, hold on failure).
# AGENT_FALLBACK=1

# Local per-model token-per-minute budget (Groq free tier: 8000). Messages beyond it
# wait up to CREW_MAX_QUEUE_SECONDS, then are held instead of hanging for ~30 s.
CREW_TPM_LIMIT=7000
CREW_MAX_QUEUE_SECONDS=3
# Output cap per agent call. Groq counts it toward the per-minute limit up front. If
# analyses fail with truncated/malformed output, raise it; the operator token usage
# shows the real completion size.
CREW_MAX_TOKENS=600
CREW_MAX_TOKENS=900
CREW_MAX_CONCURRENCY=4

# Containment is sticky but not permanent: it ends this long after the last
# hostile verdict, or after N consecutive benign verdicts (0 disables), or when
# an operator releases the session (POST /security/sessions/<id>/release).
CONTAINMENT_TTL_SECONDS=900
CONTAINMENT_CLEAN_TURNS=3

# Semantic sensor (evidence for the agents). Use e.g.
# sentence-transformers/paraphrase-multilingual-mpnet-base-v2 for non-English
# traffic, then re-check SENTRY_THRESHOLD with validation/evaluate.py.
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# SENTRY_THRESHOLD=0.70

# Comma-separated browser origins allowed to call the API
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chat speed / quota
# Models tried in order; Groq free tier caps tokens per model per day
CHAT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
